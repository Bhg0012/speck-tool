#!/bin/bash
# Speck.app: click it (e.g. in the Dock) to update Speck from GitHub and start it, with no Terminal window.
# It runs exactly the same steps as "Start Speck (Mac).command" (scripts/start.js, which updates first).
# When something needs you to watch or act (first install, model download, missing Node), it opens
# that launcher in Terminal instead.
# Everything lives in functions called from the last line, so an update can safely replace this file.

SAVED="$HOME/Library/Application Support/Speck/repo-path"

is_repo() {
  [ -f "$1/scripts/start.js" ] && [ -f "$1/Start Speck (Mac).command" ]
}

# Finds the speck-tool folder even when macOS runs this app from a hidden
# "translocated" copy (downloaded apps) or the app was moved out of the folder.
find_repo() {
  local c
  c="$(cd "$(dirname "$0")/../../.." 2>/dev/null && pwd)"
  if is_repo "$c"; then echo "$c"; return 0; fi
  if [ -f "$SAVED" ]; then
    c="$(cat "$SAVED")"
    if is_repo "$c"; then echo "$c"; return 0; fi
  fi
  for c in "$HOME/speck-tool" "$HOME/speck-tool-main" "$HOME"/Desktop/speck-tool* "$HOME"/Downloads/speck-tool* \
    "$HOME"/Documents/speck-tool* "$HOME"/Developer/speck-tool* "$HOME"/Applications/speck-tool*; do
    if is_repo "$c"; then echo "$c"; return 0; fi
  done
  # Last resort: ask Spotlight where the Mac launcher lives.
  while IFS= read -r c; do
    case "$c" in *AppTranslocation* | */.Trash/*) continue ;; esac
    c="$(dirname "$c")"
    if is_repo "$c"; then echo "$c"; return 0; fi
  done < <(mdfind -name "Start Speck (Mac).command" 2>/dev/null)
  return 1
}

alert() {
  osascript -e 'on run argv' -e 'display alert (item 1 of argv) message (item 2 of argv)' -e 'end run' "$1" "$2" >/dev/null 2>&1
}

open_launcher() {
  open -a Terminal "$1/Start Speck (Mac).command"
}

main() {
  local repo out code
  if ! repo="$(find_repo)"; then
    alert "Speck" "Couldn’t find the speck-tool folder. Double-click “Start Speck (Mac).command” inside it once, then try again."
    return 1
  fi
  mkdir -p "$(dirname "$SAVED")" && printf '%s' "$repo" >"$SAVED"
  # Downloaded copies are quarantined, which makes macOS run them from a temporary
  # location and block the launchers. Clear it for Speck's own folder only.
  xattr -dr com.apple.quarantine "$repo" >/dev/null 2>&1
  cd "$repo" || return 1

  # Apps opened from the Dock don't get the Terminal PATH.
  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
  [ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1

  if ! command -v node >/dev/null 2>&1; then
    open_launcher "$repo"
    return 0
  fi

  out="$(node scripts/start.js --quiet 2>&1)"
  code=$?
  if [ "$code" -eq 3 ]; then
    open_launcher "$repo"
  elif [ "$code" -ne 0 ]; then
    alert "Speck couldn’t start" "$(printf '%s' "$out" | sed 's/\x1b\[[0-9;]*m//g' | grep -v '^[[:space:]]*$' | tail -4)"
  fi
  return 0
}

main "$@"; exit $?
